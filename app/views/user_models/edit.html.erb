<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
  <div class="card" style="width: 800px; padding: 2rem; border: 2px solid #000; border-radius: 1rem;">
    <h1 class="mb-4 text-center">アカウント編集</h1>
    <% if (@user_model || current_user)&.errors&.any? %>
      <div class="alert alert-danger">
        <strong>入力内容にエラーがあります。</strong>
        <ul class="mb-0">
          <% (@user_model || current_user).errors.full_messages.each do |m| %>
            <li><%= m %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= form_with model: (@user_model || current_user) do |f| %>
      <div class="form-group row mb-3 p-2 border border-primary rounded">
        <label class="col-sm-4 col-form-label fw-bold"><%= "名前" %></label>
        <div class="col-sm-8">
          <%= f.text_field :name, class: "form-control border border-primary" %>
          <% f.object.errors.full_messages_for(:name).each do |msg| %>
            <div class="text-danger small mt-1"><%= msg %></div>
          <% end %>
        </div>
      </div>

      <div class="form-group row mb-3 p-2 border border-primary rounded">
        <label class="col-sm-4 col-form-label fw-bold"><%= "メールアドレス" %></label>
        <div class="col-sm-8">
          <%= f.email_field :email, class: "form-control border border-primary" %>
          <% f.object.errors.full_messages_for(:email).each do |msg| %>
            <div class="text-danger small mt-1"><%= msg %></div>
          <% end %>
        </div>
      </div>

      <div class="form-group row mb-3 p-2 border border-primary rounded">
        <label class="col-sm-4 col-form-label fw-bold"><%= "パスワード" %></label>
        <div class="col-sm-8">
          <%= f.password_field :password, class: "form-control border border-primary" %>
          <% f.object.errors.full_messages_for(:password).each do |msg| %>
            <div class="text-danger small mt-1"><%= msg %></div>
          <% end %>
        </div>
      </div>

      <div class="form-group row mb-3 p-2 border border-primary rounded">
        <label class="col-sm-4 col-form-label fw-bold"><%= "パスワード確認" %></label>
        <div class="col-sm-8">
          <%= f.password_field :password_confirmation, class: "form-control border border-primary" %>
          <% f.object.errors.full_messages_for(:password_confirmation).each do |msg| %>
            <div class="text-danger small mt-1"><%= msg %></div>
          <% end %>
        </div>
      </div>

      <%= f.submit "編集完了", class: "btn btn-success w-100 mt-3" %>
    <% end %>
  </div>
</div>
