<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
  <div class="card border-dark rounded" style="width: 1000px; max-width: 1000px;">
    <div class="card-body">
      <h1 class="card-title text-center mb-4">アカウント設定</h1>

      <div class="d-flex justify-content-between align-items-center rounded p-2 mb-2 border border-primary">
        <span>名前</span>
        <span><%= @user_model.name %></span>
      </div>
      <div class="d-flex justify-content-between align-items-center rounded p-2 mb-2 border border-primary">
        <span>メールアドレス</span>
        <span><%= @user_model.email %></span>
      </div>
      <div class="d-flex justify-content-between align-items-center rounded p-2 mb-2 border border-primary">
        <span>パスワード</span>
        <span>********</span>
      </div>

      <div class="d-flex justify-content-center mt-4">
        <%= link_to "アカウント編集", edit_user_model_path(@user_model), class: "btn btn-primary mx-2" %>
        <%= link_to "プロフィール編集", edit_profile_path, class: "btn btn-primary mx-2" %>
        <%= button_tag type: "button", class: "btn btn-danger mx-2", data: { bs_toggle: "modal", bs_target: "#accountDel-#{@user_model.id}" } do %>
          アカウント削除
        <% end %>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="accountDel-<%= @user_model.id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">アカウントを削除しますか？</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">この操作は取り消せません。</p>
        <ul class="mb-0 small text-muted">
          <li>プロフィール情報（名前・メール・自己紹介）が削除されます。</li>
          <li>あなたが作成した施設や予約がある場合、関連データも削除される可能性があります。</li>
        </ul>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
        <%= button_to "削除する", user_model_path(@user_model), method: :delete, class: "btn btn-danger", form: { data: { turbo: false } } %>
      </div>
    </div>
  </div>
</div>
